{% extends 'jinja2_templates/base.jinja2' %}
{% block metadata %}
{{ super() }}
{% endblock %}
{% block base %}
{{ super() }}
{% endblock %}
{% block actions %}
context:
  kernel_start_message: ''

actions:
- deploy:
    to: fvp
    images:
{% for name, img in binaries.items() %}
      {{ name }}:
        url: {{ data_url_prefix }}/{{ img.data }}
{% endfor %}
- boot:
    failure_retry: 3
    method: fvp
    docker:
      name: {{ docker_prefix }}/fvp:fvp_rd_v3_r1_0.0_10096_linux64
      local: true
    prompts:
    - 'root@lava '
    image: /opt/model/FVP_RD_V3_R1/models/Linux64_GCC-9.3/FVP_RD_V3_R1
    timeout:
      minutes: 10
    console_string: 'terminal_rse_uart: Listening for serial connection on port (?P<PORT>\d+)'
    license_variable: '{{ license_variable }}'
    use_telnet: True
    arguments:
    -  "--simlimit 900"
    -  "-C socket0.css0.sysctrl.rse.rom.raw_image={ROM}"
    -  "--data socket0.css0.sysctrl.rse.cpu={FLASH}@0xB0000000"
    -  "--data socket0.css0.sysctrl.rse.cpu={COMBINED_PROVISIONING_MESSAGE_0}@0x310e0000"
    -  "-C socket0.css1.sysctrl.rse.rom.raw_image={ROM}"
    -  "--data socket0.css1.sysctrl.rse.cpu={FLASH}@0xB0000000"
    -  "--data socket0.css1.sysctrl.rse.cpu={COMBINED_PROVISIONING_MESSAGE_1}@0x310e0000"
    -  "-C socket0.css0.sysctrl.rse.intchecker.ICBC_RESET_VALUE=0x0000011B"
    -  "-C socket0.css1.sysctrl.rse.intchecker.ICBC_RESET_VALUE=0x0000011B"
    -  "-C socket0.css0.sysctrl.rse.GRETREG_RESET=2"
    -  "-C socket0.css1.sysctrl.rse.GRETREG_RESET=2"
    -  "-C socket0.board0.rse2rse_mhu0.NUM_CH=16"
    -  "-C socket0.board1.rse2rse_mhu0.NUM_CH=16"
    -  "-C socket0.css0.sysctrl.rse.DISABLE_GATING=true"
    -  "-C socket0.css1.sysctrl.rse.DISABLE_GATING=true"
    -  "-C socket0.css0.sysctrl.rse_uart.shutdown_on_eot=1"
    -  "-C socket0.css1.sysctrl.rse_uart.shutdown_on_eot=1"
    -  "-C socket0.disable_visualisation=1"

    prompts:
    - '(.*)'

- test:
    monitors:
    {%- for monitor in monitors %}
    - name: "{{monitor.name}}"
      start: "{{monitor.start}}"
      end: "{{monitor.end}}"
      pattern: "{{monitor.pattern}}"
      fixupdict:
         '{{monitor.fixup.pass}}': pass
         '{{monitor.fixup.fail}}': fail
         {%- if monitor.fixup.skip %}
         '{{monitor.fixup.skip}}': skip
         {%- endif %}
    {%- endfor %}

{% endblock %}
