{% extends 'jinja2_templates/base.jinja2' %}
{% block actions %}
actions:
    - deploy:
        timeout:
          minutes: 12
        to: musca
        images:
{% for name, img in binaries.items() %}
          {{ name }}:
            url: {{ data_url_prefix }}/{{ img.data }}
{% endfor %}

    - boot:
        method: musca

    - test:
        monitors:
        {%- for monitor in monitors %}
        - name: "{{monitor.name}}"
          start: "{{monitor.start}}"
          end: "{{monitor.end}}"
          pattern: "{{monitor.pattern}}"
          fixupdict:
              '{{monitor.fixup.pass}}': pass
              '{{monitor.fixup.fail}}': fail
              {%- if monitor.fixup.skip %}
              '{{monitor.fixup.skip}}': skip
              {%- endif %}
        {% endfor %}
{% if erpc_enabled is defined and erpc_enabled %}
- test:
    namespace: test
    timeout:
      minutes: 30
    definitions:
    - repository:
        metadata:
          format: Lava-Test Test Definition 1.0
          name: tfm-erpc-tests
          description: "TF-M eRPC Non-Secure test suite"
        run:
          steps:
          - lava-test-case erpc-uart-config --shell stty -F {{ erpc_uart_device | default('/dev/ttyUSB0') }} {{ erpc_uart_baudrate | default(115200) }}
          - lava-test-case erpc-test-execution --shell |
              {{ erpc_client_binary }} \
                --uart {{ erpc_uart_device | default('/dev/ttyUSB0') }} \
                --baudrate {{ erpc_uart_baudrate | default(115200) }} \
                --test-suite {{ erpc_test_suite | default('ns_regression') }}
{% endif %}
{% endblock %}

{% block metadata %}
metadata:
  build_no: {{ build_no }}
  name: {{ name }}
  platform: {{ platform }}
  build_name: {{ build_name }}
  device_type: {{ device_type }}
  build_job_url: {{ build_job_url }}
{% endblock %}
